[Unit]
Description=ChromaFlow lighting SDK (localhost OpenRGB sibling)
Documentation=https://github.com/edwardlthompson/chromaflow
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/chromaflow daemon --sdk
Restart=on-failure
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=graphical-session.target
